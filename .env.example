# 模型（pi 运行时）。默认走 pi 内置 deepseek provider，只需 key：
#   DEEPSEEK_API_KEY=...            # pi 内置 provider "deepseek"
# 也可用任意 OpenAI 兼容端点（走 .pi/models.json 的 custom provider）：
#   REPORT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   REPORT_LLM_API_KEY=sk-...
# 模型选择用 (provider, model_id) 对：
#   REPORT_PROVIDER=deepseek
#   REPORT_MODEL_ID=deepseek-v4-pro

# 数据源挂载根（只读）。生产：/mnt/mfs/mfs-srv.example.com/Data；开发机可指向本地夹具。
# 单挂载根覆盖：REPORT_MOUNT_ROOT_MFS=/mnt/mfs/mfs-srv.example.com/Data
# REPORT_MOUNT_ROOT_DEV=/tmp/report-fixture

# 任务工作目录（plan / validation / 输出文件）
# REPORT_WORK_DIR=./work
