{
  "id": "case-16-rf-formula-conflict",
  "title": "5G 射频目标列覆盖公式 → 必须阻断",
  "description": "模拟错误规划：把测量值试图写入带有 =IF(...) 判定公式的 H 列（Status）。Write Safety Gate 必须识别并阻断执行，不得破坏模板内既有的计算公式。",
  "kind": "deterministic",
  "scenario": "validate-plan",
  "dataset_id": "ds_rf_calibration",
  "plan": {
    "plan_version": 2,
    "output": {
      "mode": "one_file_per_sn",
      "sn_source": "parent_directory_name",
      "filename_pattern": "{sn}_FIR.xlsx"
    },
    "source_file": {
      "pattern": "*_rf_cal*.xml",
      "multiple_match_policy": "latest_mtime"
    },
    "source_records": {
      "record_selector": ".//point",
      "key_selector": "@id",
      "field_storage": {
        "item_selector": "./measure",
        "field_name_selector": "@metric",
        "field_value_selector": "@val"
      }
    },
    "template": {
      "sheet_scope": [
        "RF_Tx_Cal"
      ],
      "join": {
        "template_key_column": "B",
        "source_key": "point.@id",
        "match_mode": "normalized_exact"
      },
      "mappings": [
        {
          "source_field": "tx_pwr",
          "target_column": "D"
        },
        {
          "source_field": "evm",
          "target_column": "H"
        }
      ]
    },
    "normalization": {
      "trim_whitespace": true,
      "case_sensitive": true,
      "rules": []
    },
    "missing_value_policy": "leave_blank_and_report",
    "missing_case_policy": "warning",
    "duplicate_source_key_policy": "block"
  },
  "expect": {
    "execution_allowed": false,
    "gates": "not_all_pass",
    "error_codes": [
      "FORMULA_OVERWRITE"
    ]
  }
}
