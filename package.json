{
  "name": "report-self-assistant-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Report Self-Assistant Agent — agentic planning on a read-only mounted test-data filesystem, with a deterministic report workflow.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixture": "python3 tests/make_fixture.py ${FIXTURE_DIR:-/tmp/report-fixture}",
    "fixture:complex": "python3 tests/make_complex_fixtures.py",
    "regress": "bash tests/regress.sh ${FIXTURE_DIR:-/tmp/report-fixture}",
    "test:node": "tsx --test tests/node/*.test.ts",
    "test": "npm run regress && npm run test:node",
    "tools": "python3 tools/report_tools.py",
    "plan": "tsx src/cli.ts plan",
    "ask": "tsx src/cli.ts ask",
    "smoke": "tsx src/smoke.ts",
    "serve": "tsx src/server.ts",
    "serve:dev": "tsx watch src/server.ts",
    "cases": "tsx src/run-cases.ts",
    "cases:deterministic": "tsx src/run-cases.ts --deterministic",
    "cases:mock": "REPORT_PLANNER=mock tsx src/run-cases.ts",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "sync:penguin": "bash scripts/sync-to-penguin-agent.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
